# Renseignée automatiquement par `npx convex dev` pour le développement local.
CONVEX_DEPLOYMENT=

# URL publique du déploiement Convex utilisée par le navigateur.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Le salon vocal utilise LIVEKIT_URL, LIVEKIT_API_KEY et LIVEKIT_API_SECRET
# dans les variables d'environnement du déploiement Convex, pas dans Vite.
